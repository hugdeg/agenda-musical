---
const { concert } = Astro.props;

const socialLabels = {
  site_web: { label: "Site", icon: "fa-globe" },
  instagram: { label: "Instagram", icon: "fa-instagram" },
  facebook: { label: "Facebook", icon: "fa-facebook" },
  spotify: { label: "Spotify", icon: "fa-spotify" },
  deezer: { label: "Deezer", icon: "fa-deezer" },
  qobuz: { label: "Qobuz", icon: "fa-music" },
  linktree: { label: "Linktree", icon: "fa-link" }
};
---

<article class="concert-card" style="background:#ffffff; border:1px solid #e2e8f0; border-radius:16px; padding:24px; margin-bottom:24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
  {concert.affiche && (
    <img src={concert.affiche} alt={concert.titre} style="width:100%; height:240px; object-fit:cover; border-radius:12px; margin-bottom:16px;" />
  )}
  
  <span style="font-size:12px; font-weight:700; color:#0284c7; text-transform:uppercase; letter-spacing:0.05em;">{concert.lieu}</span>
  <h2 style="font-size:24px; font-weight:800; color:#0f172a; margin:4px 0 8px 0;">{concert.artiste}</h2>
  <p style="font-size:14px; color:#64748b; margin-bottom:16px;">{concert.genres.join(', ')}</p>

  <!-- Lecteur Audio Hiérarchique : Bandcamp > YouTube > SoundCloud -->
  <div class="player-container" style="margin-bottom:20px; border-radius:8px; overflow:hidden;">
    {concert.media?.bandcamp && (
      <iframe style="border:0; width:100%; height:120px;" src={concert.media.bandcamp} seamless></iframe>
    )}
    {!concert.media?.bandcamp && concert.media?.youtube && (
      <iframe style="border:0; width:100%; height:200px;" src={concert.media.youtube} allowfullscreen></iframe>
    )}
    {!concert.media?.bandcamp && !concert.media?.youtube && concert.media?.soundcloud && (
      <iframe style="border:0; width:100%; height:166px;" src={concert.media.soundcloud}></iframe>
    )}
  </div>

  <!-- Réseaux Sociaux -->
  <div class="social-links" style="display:flex; flex-wrap:wrap; gap:8px;">
    {Object.entries(concert.reseaux || {}).map(([key, url]) => {
      if (!url) return null;
      const info = socialLabels[key] || { label: key, icon: "fa-link" };
      return (
        <a href={url} target="_blank" rel="noopener noreferrer" style="background:#f1f5f9; color:#334155; padding:6px 12px; border-radius:6px; font-size:13px; text-decoration:none; font-weight:500;">
          {info.label}
        </a>
      );
    })}
  </div>
</article>
